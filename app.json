{
  "expo": {
    "name": "NEGUEZI",
    "slug": "neguezi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E0F0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.satigui.neguezi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "NEGUEZI utilise tes photos pour ton profil et ta salle."
        }
      ],
      "expo-font",
      "react-native-audio-api"
    ],
    "backgroundColor": "#1E0F0C",
    "extra": {
      "eas": {
        "projectId": "b2089f90-adbf-4e9e-9104-2a953339abf0"
      }
    },
    "owner": "sassa2001",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b2089f90-adbf-4e9e-9104-2a953339abf0",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
